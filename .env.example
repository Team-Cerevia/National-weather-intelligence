# Environment Configuration Template (.env.example)
# Copy this file to .env locally and fill in your secrets.
# NEVER commit your actual .env file or hardcode secrets in source code!

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here

# Redis Streams Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=weather_reports_stream

# External API Keys (Optional / Track-Specific)
# Open-Meteo API is free and requires no key by default.
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
# IMD / Weather API Keys (if applicable)
WEATHER_API_KEY=your_weather_api_key_here
SOCIAL_API_BEARER_TOKEN=your_social_bearer_token_here

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
